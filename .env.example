# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=Cluster0

# JWT Configuration
JWT_SECRET=your-super-secret-key-here-change-in-production
REFRESH_TOKEN_SECRET=your-refresh-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000

# Only these emails can use admin APIs / dashboard (comma-separated)
ADMIN_ALLOWED_EMAILS=mohamed.razzak111@gmail.com

# Browser origins allowed to call the API (comma-separated).
# Mobile apps (no Origin header) are always allowed.
CORS_ORIGINS=https://trainifypro.com,https://www.trainifypro.com

# Shared secret required on every /api request via header: X-Api-Key
# Must be configured in the mobile app, trainifypro.com, and admin dashboard.
# See CLIENT_API_KEY.md for frontend usage.
CLIENT_API_KEY=replace-with-your-client-api-key

# Platform fee % added on top of coach monthly price (also caps admin promo discount %)
PERCENTAGE=10

# Google Sign-In (Athletes). Comma-separated OAuth client IDs (iOS + Android + Web).
# Used to verify idTokens from the mobile app. See Google Cloud Console → Credentials.
GOOGLE_CLIENT_IDS=ios-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com

# Used by scripts/translateExercises.js to translate exercise names and instructions once.
# API key from Google AI Studio (aistudio.google.com/api-keys).
GEMINI_API_KEY=
